        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{application=\"subsidy-app\", uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{method}} {{uri}} {{status}}"
