    {
      "id": 8,
      "type": "timeseries",
      "title": "5xx 에러율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
