      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"subsidy-app\", uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p95 {{uri}}"
